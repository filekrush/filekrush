---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
const siteUrl = 'https://filekrush.com';
const canonicalUrl = canonical ? `${siteUrl}${canonical.endsWith('/') ? canonical : canonical + '/'}` : siteUrl + '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="preload" href="/fonts/vend-sans-latin.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Filekrush" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://filekrush.com/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://filekrush.com/og-image.png" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-0YT680XGJG');

      function loadGtm() {
        if (window.__gtmLoaded) return;
        window.__gtmLoaded = true;
        const script = document.createElement('script');
        script.src = 'https://www.googletagmanager.com/gtag/js?id=G-0YT680XGJG';
        script.async = true;
        document.head.appendChild(script);
      }
      ['scroll', 'keydown', 'click', 'touchstart', 'mousemove'].forEach((event) =>
        window.addEventListener(event, loadGtm, { once: true, passive: true })
      );
      setTimeout(loadGtm, 5000);
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
