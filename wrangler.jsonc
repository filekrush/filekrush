{
	"compatibility_date": "2026-05-10",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "filekrush",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"images": {
		"binding": "IMAGES"
	},
	"kv_namespaces": [
		{ "binding": "SESSION", "id": "9962796335e34278a5dca81e8e240a09" }
	],
	"observability": {
		"enabled": true
	}
}
